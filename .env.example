# Copy to .env.local and fill in. Only the Supabase values are required to run locally.

# --- Supabase (required: auth, leaderboard, multiplayer rooms) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- eBay Browse API (required for PriceDrop) ---
EBAY_PROD_APP_ID=
EBAY_PROD_CERT_ID=
EBAY_VERIFICATION_TOKEN=

# --- Dataset refresh only (not needed at runtime; games ship static snapshots) ---
TMDB_API_KEY=
USDA_API_KEY=
REST_COUNTRIES_API_KEY=
